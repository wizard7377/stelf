# Trivial Unary Arithmetic

%sort nat %.
%scope nat %{
  %term 0 nat
  %term S %pi nat %-> nat
%}

%sort nt {_ nat} %.
%scope nt %{
  %term nt_z nt %(0 nat)
  %term nt_s {{X}}
    %if nt (%(S nat) X)
    %<- nt X
%}

%sort plus {_ nat} {_ nat} {_ nat} %.
%scope plus %{
  %term p_z {{Y}} plus %(0 nat) Y Y
  %term p_s {{X Y Z}}
    %if plus (%(S nat) X) Y (%(S nat) Z)
    %<- plus X Y Z
%}

%sort acker {_ nat} {_ nat} {_ nat} %.
%scope acker %{
  %term a_1 {{Y}} acker %(0 nat) Y (%(S nat) Y)
  %term a_2 {{X Z}}
    %if acker (%(S nat) X) %(0 nat) Z
    %<- acker X (%(S nat) %(0 nat)) Z
  %term a_3 {{X Y Zp Z}}
    %if acker (%(S nat) X) (%(S nat) Y) Z
    %<- acker (%(S nat) X) Y Zp
    %<- acker X Zp Z
%}

%mode acker %in %in %out %.
%worlds () (acker _ _ _)
