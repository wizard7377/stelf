# Lists of Natural Numbers

%sort nat %.
%scope nat %{
  %term 0 nat
  %term S %pi nat %-> nat
%}

%sort list %.
%scope list %{
  %term nil list
  %term cons %pi nat %-> list %-> list
%}

%sort append {_ list} {_ list} {_ list} %.
%scope append %{
  %term nil {{L}} append %(nil list) L L
  %term cons {{H T L M}}
    %if append (%(cons list) H T) L (%(cons list) H M)
    %<- append T L M
%}

%mode append %in %in %out %.
%worlds () (append _ _ _)
%total X (append X _ _)
