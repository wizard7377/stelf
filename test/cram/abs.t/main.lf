%sort nat %.
%term zero nat %.
%term succ {_ nat} nat %.

%sort holds {_ nat} %.
%term ok holds zero %.

%scope confusion %term zero nat %.
%scope confusion %term probe-abs holds (%abs zero) %.
%scope confusion %term probe-val holds (%val zero) %.
%scope confusion %term probe-abs-q holds (%abs ( zero confusion )) %.
%scope confusion %term probe-val-q holds (%val ( zero confusion )) %.

%scope onlyscoped %term lonely nat %.
%scope onlyscoped %term probe-fallback holds (%abs lonely) %.
