# The Syntax of the Lambda Calculus

%sort κ 
%sort τ 
%sort e 
%symbol kind κ
%symbol type τ
%symbol term e
%sort : term type
%prec %none 1 : %.
%scope kind %{
  %. Kind of types
  %term * kind 
  %. Pi types
  %term => 
    {A type} 
    {B 
      {X term} 
      %if X : A 
      %-> kind
    } 
    kind
  %term @ 
  %pi kind 
  %-> term
  %-> kind
%}

%scope type %{
  %term ->
    {A type}
    {B
      {X term}
      %if X : A
      %-> type
    }
    type
  %prec %right 5 -> %.
  %term Λ
    %pi (%pi term %-> type)
    %-> type
  %term @
    %pi type
    %-> term
    %-> type
%}

%scope term %{
  %term λ
    %pi (%pi term %-> term)
    %-> term
  %term @
    %pi term
    %-> term
    %-> term
%}
