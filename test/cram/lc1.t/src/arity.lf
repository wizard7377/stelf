
%require types %.

# Arities (simple types)
%sort arity 
%term nil {T type} arity
%term ->> %pi arity %-> arity %-> arity 

%prec %right 5 ->> %.


%sort erase type arity 
%scope erase %{
  %term @ 
    {{A B T U}}
    %if erase A T
    %-> ({X term} {P X : A} erase (B X P) U)
    %-> erase (A -> B) U
  %. TODO 
%}

%mode erase %in %out 

