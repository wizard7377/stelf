[toml-schema]
version = "1.0.0"


# ─── Types ────────────────────────────────────────────────────────────────────
#
# Reusable type definitions referenced throughout the schema.

[types]


  # A valid STELF identifier: any non-whitespace, non-bracket character sequence,
  # with %%. as an escape prefix for special characters.
  [types.name]
  type    = "string"
  pattern = "([^\s\(\)\[\]\{\}]|%%.)+"


  # A path to a file.
  [types.file]
  type = "string"


  # A path to a directory.
  [types.dir]
  type = "string"


  # A URL string.
  [types.url]
  type = "string"


  # ── Dependency variants ──────────────────────────────────────────────────────
  #
  # A dependency can be specified in four ways (see types.dependency below).


  # An external dependency: downloaded from a URL into a local directory, then
  # treated as a local dependency rooted at that directory.
  [types.dependencyExternal]
  type = "table"

    # The URL to download from.
    [types.dependencyExternal.url]
    typeof = "types.url"

    # The local directory to download into.
    [types.dependencyExternal.path]
    typeof = "types.dir"

    # What to do with the downloaded content (treated as another dependency).
    [types.dependencyExternal.action]
    typeof = "types.dependency"


  # An installed (system-level) dependency, identified by name.
  # Future versions may use this for a theory/package manager.
  [types.dependencyInstalled]
  type = "table"

    # The canonical name of the installed package.
    [types.dependencyInstalled.name]
    typeof = "types.name"

    # The toplevel namespace under which this package is imported in the project.
    # Defaults to the package name if omitted.
    [types.dependencyInstalled.alias]
    typeof   = "types.name"
    optional = true


  # A local dependency defined in a *.toml file on disk.
  [types.dependencyLocal]
  type = "table"

    # Path to the dependency's .toml file. Defaults to the current file.
    [types.dependencyLocal.path]
    type     = "file"
    optional = true

    # The name of the group within that file to depend on.
    [types.dependencyLocal.name]
    type = "string"

    # The toplevel namespace under which this dependency is imported.
    # Defaults to the group name if omitted.
    [types.dependencyLocal.alias]
    type     = "string"
    optional = true


  # A shorthand local dependency: just a name, equivalent to a dependencyLocal
  # with only the name field set (path defaults to the current file).
  [types.dependencyShort]
  typeof = "types.name"


  # A dependency is any one of the four forms above.
  [types.dependency]
  anyof = [
    "types.dependencyExternal",
    "types.dependencyInstalled",
    "types.dependencyLocal",
    "types.dependencyShort",
  ]


  # ── Group ────────────────────────────────────────────────────────────────────
  #
  # A group (also called a theory) is the unit of modularity in STELF.
  # Each group has a name, a root file, source directories, and dependencies.

  [types.group]
  type = "table"

    # The name of this group, used to refer to it as a dependency.
    [types.group.name]
    typeof = "types.name"

    # The entry-point file loaded when this group is imported. It is responsible
    # for opening (re-exporting) other files in the group.
    [types.group.main]
    typeof = "types.file"

    # Source directories that form the base search paths for this group's files.
    [types.group.src]
    type     = "array"
    itemtype = "types.dir"
    optional = true
# Optional, omission equivalent to a list containing only "."

    # The list of other groups this group depends on.
    [types.group.dependencies]
    type     = "array"
    itemtype = "types.dependency"
    optional = true 
    # Optional, ommision equivalent to empty list 
    
    # If true, this group cannot be used as a dependency by other groups;
    # it can only be loaded directly at the REPL or CLI.
    # Defaults to false.
    [types.group.local]
    type     = "boolean"
    optional = true


# ─── Elements ─────────────────────────────────────────────────────────────────
#
# Top-level structure of a stelf.toml file.
# By convention, groups are declared using the [[group]] array-of-tables syntax.

[elements]

  # The group to load by default when opening the REPL without specifying one.
  # If omitted, the user must name a group explicitly on the command line.
  # Does not affect how this file behaves when used as a dependency.
  [elements.interactive]
  typeof   = "types.name"
  optional = true

  # The list of groups defined in this file.
  [elements.group]
  type      = "array"
  arraytype = "table"
  itemtype  = "types.group"
