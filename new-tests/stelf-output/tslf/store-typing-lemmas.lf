%sort lt-look-wf %.
%mode lt-look-wf %in %in %in %out %.
%term _ 
	%pi (lt-look-wf (lt-look/miss LL) (st-wf/cons LCS _ _ _) LG DU)
	%<- (loc-less-pred LG LG')
	%<- (lt-look-wf LL LCS LG' DU) %.
%term _ 
	%pi (lt-look-wf lt-look/hit (st-wf/cons _ _ _ _) DG DU)
	%<- (loc-less-not-refl DG DU) %.
%worlds () (lt-look-wf _ _ _ _) %.
%total D1 (lt-look-wf _ D1 _ _) %.
