(*
  STELF Grammar — EBNF with Implementation Notes
  ==============================================
  The complete surface grammar of STELF, as implemented.

  Notation:
    rule = ... ;          production rule
    { x }                 zero or more repetitions of x
    [ x ]                 optional x
    x | y                 choice
    ?...?                 regex literal (not EBNF meta-syntax)
    (*  *)                comment

  Implementation:
    Tokens / lexical:    src/Lang/Parsing/Parser.ml
    Expressions:         src/Fronts/Modern/Modern.ml
    Commands:            src/Fronts/Modern/Cmd.ml
    CST types:           src/Common/Cst/Cst.ml, src/Common/Cst/LENS.ml
    Printer (inverse):   src/Pretty/Lex.ml, src/Pretty/Pretty.ml

  Companion documents:
    stelf.md    — prose reference, with rationale and Twelf comparison
    tokens.md   — token tables for lexer and highlighter authors

  THREE THINGS EBNF CANNOT EXPRESS, which an implementor must handle separately:

  1. OPERATOR PRECEDENCE IS DYNAMIC.  The `atom { atom }` run in `expr` is
     parsed FLAT and resolved afterwards by a shift/reduce pass
     (Modern.ml:176-278) against a fixity table that `%prec` mutates AT PARSE
     TIME (Cmd.ml:587).  Juxtaposition is left-associative at strength 10000
     (Modern.ml:125-130); `%prec` operators occupy 0..9999; higher binds
     tighter.  A generated parser should mirror this: parse juxtaposition flat,
     defer operator resolution to a later pass.  Do not attempt to encode
     precedence in the grammar.

  2. KEYWORD BOUNDARIES.  A `%`-keyword must be followed by EOF or one of the
     ten delimiter bytes (Parser.ml:40-52).  Without this, `%term` matches the
     prefix of `%terminates`.  Ordering hazards are flagged inline below.

  3. `%` IS CONTEXT-DEPENDENT.  `%%` is an identifier escape inside a term but
     a line comment between commands; `%[` opens a text literal whose delimiter
     length is counted, not fixed.  A scannerless or external-scanner approach
     is required.  See tokens.md.
*)


(* ─────────────────────────── Lexical primitives ─────────────────────────── *)

delimiter
    (* The ONLY characters that terminate an identifier (Parser.ml:62-65).
       Everything else — including `.` `:` `=` `-` `>` `+` `,` digits, and all
       bytes >= 0x80 — is an ordinary identifier character.

       NOTE `.` is NOT a delimiter.  `ns.name` is ONE identifier.  STELF has no
       dotted-path syntax; namespaces are written `%(ns name)`. *)
    = ? [ \t\n(){}\[\]%] ?
    ;

id_char
    (* One character of an identifier: any non-delimiter byte, or an escape.
       `%%X` contributes the literal byte X (Parser.ml:56-60), which is how a
       delimiter — or a keyword-looking name — is written inside an identifier:
         %%%       -> the identifier "%"
         %%%term   -> the identifier "%term" (NOT the keyword)
         %%(       -> the identifier "("
       There is no other escape form.  No backslash escapes, no quoting. *)
    = ? [^ \t\n(){}\[\]%] ?
    | "%%" , ? . ?
    ;

ident
    (* One or more id_chars (Parser.ml:70-71).  Trailing whitespace and line
       comments are consumed with the token.

       The first character decides the lexical CLASS (Modern.ml:338-341):
         [A-Z_] -> uppercase class: a metavariable, implicitly quantified and
                   solved by unification.  So `X`, `Nat`, `_C1` are variables.
         else   -> lowercase class: a constant reference or bound variable.
       `{{ ... }}` (see expr_trail) overrides this classification lexically.

       The exact string "_" is in NEITHER class: it is the omitted term.  The
       test is on the WHOLE identifier, so `_0` is an ordinary uppercase-class
       name, not `_` followed by `0` (Modern.ml:285-294). *)
    = id_char , { id_char }
    ;

number
    (* An unsigned decimal integer.  There is NO general numeric literal token:
       digits are ordinary identifier characters, and digit runs are matched ad
       hoc in exactly two places — `%prec` levels (Modern.ml:643-647) and
       `%query` bounds (Modern.ml:685-690).  Neither does a boundary check, so
       `10x` reads as `10` then `x`. *)
    = ? [0-9]+ ?
    ;

text_lit
    (* A text literal: `%` + n `[`  ...  `%` + n `]`, for any n >= 1
       (Parser.ml:100-132).  The delimiters GROW so a payload containing the
       closer can still be written:
         %[hello world%]        -> hello world
         %[hello%world%]        -> hello%world     (interior % is literal)
         %[[hello%]world%]]     -> hello%]world    (n = 2)
         %[[[a%]]]              -> a               (n = 3)

       Scanning: read bytes until `%`, then try to consume exactly n `]`.  On
       success the literal ends IMMEDIATELY — the scanner does not look further,
       so a longer run of `]` closes at the n-th and leaves the rest.  On
       failure the `%` and the brackets consumed are appended to the payload
       verbatim and scanning resumes.

       There are NO escapes inside the payload; it is raw bytes.  EOF before the
       closer is an error.  `%[]` fails (n=1 makes `]` payload, never closed).

       Not expressible in EBNF — the closing delimiter length depends on the
       opening one.  Requires a counting scanner. *)
    = ? "%" "["{n}  <raw bytes>  "%" "]"{n} ?
    ;

comment
    (* A line comment: `%` or `%;` followed IMMEDIATELY by whitespace, running
       to end of line.  There are NO block comments in STELF.

       Two contexts, deliberately different:
         inner (inside a term, Parser.ml:17-30)
             `% ` `%\t` `%\n` `%;` — legal anywhere whitespace is
         outer (between commands, Cmd.ml:32-58)
             `% ` `%\t`, or a run of TWO OR MORE `%`
             `%` + newline is NOT a comment here, so an empty trailing comment
             cannot swallow the following declaration (Cmd.ml:47-53)

       The whitespace requirement is what keeps `%%` (escape), `%[` (text) and
       `%name` (keyword) from being read as comments. *)
    = ( "%" | "%;" ) , ? [ \t\n] ? , ? [^\n]* ?
    ;

outer
    (* Text BETWEEN commands.  A STELF file is literate by default: everything
       that is not a command is skipped (Cmd.ml:32-58), so narrative prose needs
       no comment marker.  Skipping stops at the next `%`, then consumes a text
       literal, a `%%`-run comment, or a `% `-comment, and continues. *)
    = { ? [^%] ? | comment | text_lit }
    ;


(* ─────────────────────────── Identifier forms ───────────────────────────── *)

arg
    (* An argument position in a declaration.  `_` alone is anonymous; every
       other identifier names the binder (Modern.ml:285-294). *)
    = ident
    ;

qid_body
    (* The payload of `%val` / `%abs`.  In the parenthesised form the LAST
       element is the name and everything before it is the namespace path,
       outermost first (Modern.ml:280-303).
       Whitespace after `%val` / `%abs` IS permitted here. *)
    = "(" , ident , { ident } , ")"
    | ident
    ;

id_form
    (* Everything that can appear as a bare atom (Modern.ml:305-352).
       Alternatives are tried in this order. *)
    = "%type"                                   (* the universe; bare `type` stays an ordinary name *)
    | "%val" , qid_body                         (* qualified reference, shadow-aware *)
    | "%abs" , qid_body                         (* qualified reference, toplevel-first *)
    | "%(" , ident , { ident } , ")"            (* shorthand for `%val ( ... )` *)
    | "%(" , ident , { ident } , "(" , expr , ")" , ")"   (* local scope over expr *)
    | "_"                                       (* omitted term — a fresh placeholder *)
    | ident                                     (* uppercase or lowercase class, per `ident` *)
    ;
    (* HAZARD: `%(` is matched as the RAW string "%(" (Modern.ml:317), so no
       whitespace is permitted between `%` and `(`.  `%val (` does allow it.

       HAZARD: the inner parentheses in the local-scope form are MANDATORY.
       `%(ns M)` without them is a qualified NAME, which requires `ns` to have a
       member `M`; the local form only rewrites the names `ns` happens to
       provide (Pretty.ml:135-140).

       A qualified reference is UNCONDITIONALLY an atom (Modern.ml:155-161): it
       never consults the fixity table, so a namespaced operator can never be
       written or printed infix. *)

id_list
    (* One identifier, or a parenthesised list. *)
    = "(" , ident , { ident } , ")"
    | ident
    ;


(* ─────────────────────────── Declarations ───────────────────────────────── *)

decl
    (* A binding, replacing Twelf's `x : T`.  Three differences
       (Modern.ml:494-517):
         1. The colon is always elided:      {x nat} nat
         2. Names may share a type:          [(x y) nat] x  ==  [x nat] [y nat] x
         3. The type is optional:            [x] x   {x} x   (x y)

       TRAP: the parentheses in the multi-name form are NOT optional.
       `[x y z t]` is ONE binder `x` of type `(y z t)`, not three binders —
       the bare-name branch takes exactly one arg and parses the rest as the
       type.  This misparses silently. *)
    = "(" , arg , { arg } , ")" , [ expr ]
    | arg , [ expr ]
    ;

decl_simple
    (* An anonymous declaration written as a bare type, used for `%sort` and
       `%data` arguments (Modern.ml:519-528).  `%sort prop nat nat` and
       `%sort prop {_ nat} {_ nat}` are equivalent. *)
    = id_form
    | "(" , expr , ")"
    ;

block_item
    (* One item of a `%block` schema (Modern.ml:711-722).  The bracket shape
       carries the meaning Twelf spells with `some` / `block`:
         [x T]  "some" — a per-world variable, instantiated like a lambda binder
         {x T}  block body — a hypothesis, like a pi binder

       NB LENS.ml:356-359 documents these BACKWARDS.  The parser is
       authoritative. *)
    = "[" , decl , "]"
    | "{" , decl , "}"
    ;


(* ─────────────────────────── Expressions ────────────────────────────────── *)

(*
  The grammar has THREE SLOTS, not a precedence tower (Pretty.ml:21-34):

    expr        head forms, else `atom { atom } [ trail ]`
    expr1       atoms — safe to repeat without parentheses
    expr_trail  binders and arrows — rightmost position ONLY

  A trailing form is appended as the LAST ARGUMENT of the application, which is
  why `f y z [x nat] x y z` parses.
*)

expr1
    (* An atom (Modern.ml:415-426). *)
    = id_form
    | "(" , expr , ")"
    | text_lit
    ;

expr_trail
    (* Forms that may appear only in the rightmost position of an expression
       (Modern.ml:354-407).  An inner occurrence needs parentheses. *)
    = "[" , decl , "]" , expr                        (* lambda — Twelf [x:A] M *)
    | "{" , decl , "}" , expr                        (* pi     — Twelf {x:A} B *)
    | "{{" , { ident } , "}}" , expr                 (* scope names into the uppercase class *)
    | arrow_kw , expr , "%->" , expr , { "%->" , expr }
    | arrow_kw , expr , "%<-" , expr , { "%<-" , expr }
    | id_form
    ;
    (* `{{` must be written GLUED; `{ {` lexes as a pi binder and fails.
       `{{ ... }}` produces NO node — it only reclassifies the listed names as
       uppercase for the body (Modern.ml:365-368, 45-51), and it nests.

       ARROWS.  `%->` is right-associative and the LAST element is the body;
       `%<-` reverses it so the FIRST element is the body, matching Twelf's
       `A <- B`.  A leading arrow_kw is REQUIRED — bare `A %-> B` does not
       parse.  `%->` and `%<-` CANNOT be mixed in one chain: the chain is built
       with a single separator, so `%pi A %-> B %<- C` parses `%pi A %-> B` and
       then fails on leftover input.

       Every chain element is a full `expr` that stops only at the next
       separator, so an arrow in non-final position swallows the rest of the
       chain — parenthesise it: `%pi (%pi A %-> B) %-> C` (Pretty.ml:200-203).

       Arrows build a dedicated non-dependent Arrow node, NOT an
       anonymous-binder Pi, so the codomain is reconstructed without the domain
       in scope (Modern.ml:385-388). *)

arrow_kw
    (* Exact synonyms (Modern.ml:373).  They read differently by role — `%if`
       for a clause premise, `%pi` for a type — but the parser does not
       distinguish them.  The printer always emits `%pi`. *)
    = "%if" | "%do" | "%pi" | "%fn"
    ;

expr
    (* A full expression (Modern.ml:428-466). *)
    = "%the" , expr1 , expr        (* ascription: TYPE first, then TERM *)
    | "%local" , ident , expr      (* open a scope for one expression *)
    | expr1 , { expr1 } , [ expr_trail ]
    | expr_trail
    ;
    (* `%the` and `%local` are HEAD forms only — there is no trailing form, so
       anything narrower than a full expression position needs parentheses
       (Pretty.ml:174-176).

       `%the`'s TYPE slot is an expr1 (an atom), so `%the a b c` means
       `%the a (b c)`, NOT `(%the a b) c`.  Its TERM slot is a full expr and is
       greedy to the end.

       Surface order is `%the TYPE TERM`; the CST stores (term, type).  The two
       are swapped, and both slots have the same type so writing them backwards
       still compiles — see stelf.md §10.1. *)


(* ─────────────────────────── Command sub-grammars ───────────────────────── *)

mode
    (* Mode keywords are `%`-sigil words, not Twelf's `+` / `-` / `*` sigils
       (Modern.ml:530-545).
         %in   / %forall   Twelf `+`     input
         %out  / %exists   Twelf `-`     output
         %out1             Twelf `-1`    unique output
         %star             Twelf `*`     unconstrained *)
    = "%out1" | "%out" | "%exists" | "%in" | "%forall" | "%star"
    ;

mode_dec
    (* A mode declaration (Modern.ml:547-586).  The braced prefix and the bare
       trailing modes MAY be mixed:
         %mode {%in x nat} {%in y nat} {%out z nat} add x y z
         %mode add %in %in %out
         %mode {%in x nat} {%in y nat} add x y %out *)
    = { "{" , mode , decl , "}" } , expr , { mode }
    ;

full_mode
    (* The braced-only mode form required by `%prop` and `%proof`
       (Cmd.ml:128-133).  The short positional form is NOT accepted there.
       `many`, not `many1`: a nullary judgement (`%prop true`) is legal. *)
    = { "{" , mode , decl , "}" }
    ;

order
    (* A termination order (Cmd.ml:64-85).  Orders nest, and the empty order
       `{}` is legal — the corpus idiom for a non-recursive totality proof. *)
    = id_list                          (* argument position(s) *)
    | "[" , { order } , "]"            (* simultaneous *)
    | "{" , { order } , "}"            (* lexicographic *)
    ;

order_list
    (* `parse_order` is tried first so that a parenthesised list of bare
       variables `(D1 D2)` reads as ONE mutual order, which is what a mutual
       `%total` needs.  The grouped form is the fallback (Cmd.ml:87-96). *)
    = order
    | "(" , { order } , ")"
    ;

fixity
    (* Modern.ml:724-739.  `%middle` and `%none` are IDENTICAL — both are
       non-associative infix (Modern.ml:112-113).  There is no `%nonfix`; an
       undeclared name is simply not an operator. *)
    = "%left"       (* infix, left-associative  *)
    | "%right"      (* infix, right-associative *)
    | "%prefix"
    | "%postfix"
    | "%middle"     (* infix, non-associative *)
    | "%none"       (* infix, non-associative — same as %middle *)
    ;

reduces_rel
    (* A BARE token, not `%`-prefixed (Modern.ml:701-709).  Tried longest-first.
       `>` and `>=` are handled by swapping arguments; Twelf has only `<`, `<=`.

       HAZARD: these are matched with no boundary check, so `<=` bites into a
       longer symbolic name such as `<=>`, leaving `>` behind. *)
    = "<=" | ">=" | "<" | ">" | "="
    ;

bound
    (* A `%query` bound; `_` means unbounded (Modern.ml:685-690). *)
    = "_" | number
    ;

require_arg
    (* The argument of `%require`, shared with the `%open %require` shorthand
       (Cmd.ml:100-103).  The text form is trimmed and split on `/`; the
       identifier forms are joined with `/`.  The extension is NOT written —
       `%require %[ core %]` finds `core.lf` (Loader.ml:36-50). *)
    = text_lit
    | id_list
    ;

cmd_list
    (* An inline command block, `%{ ... %}` (Cmd.ml:213-215).

       THIS IS NOT A BLOCK COMMENT.  Twelf's `%{ ... %}` comments a region out;
       STELF's RUNS it.  Blocks nest, and may be empty. *)
    = "%{" , outer , { cmd , outer } , "%}"
    ;

cmd_body
    (* The body of `%scope`, `%data` and `%proof`: either a block or a single
       bare command (Cmd.ml:265-268, 372-376, 442-446).  `%eval` requires the
       block form. *)
    = cmd_list
    | cmd
    ;


(* ─────────────────────────── Commands ───────────────────────────────────── *)

(*
  The parser tries these 39 alternatives in the order given (Cmd.ml:217-690).
  Order is load-bearing where one keyword prefixes another; those cases are
  flagged.  Alternatives below are listed in parser order.
*)

cmd
    = "%."                                                  (* separator, not a terminator — see NOTE *)

    (* HAZARD: %querytabled MUST precede %query (Cmd.ml:225). *)
    | "%querytabled" , bound , bound , bound , expr
    | "%query" , bound , bound , bound , expr                (* THREE bounds; Twelf takes two *)
    | "%?" , expr                                           (* unbounded query, REPL shorthand *)
    | "%unique" , expr

    | "%scope" , ident , cmd_body
    | "%mode" , mode_dec
    | ( "%define" | "%def" ) , define
    | "%decl" , expr
    | "%inline" , ident , expr                              (* transparent definition; Twelf %abbrev *)
    | "%symbol" , ident , ident                             (* name alias only; cannot alias keywords *)
    | "%freeze" , id_list
    | "%thaw" , id_list                                     (* requires the `unsafe` flag *)

    | "%sort" , id_list , { "{" , decl , "}" | decl_simple }
    | "%data" , ident , { "{" , decl , "}" | decl_simple } , cmd_body
    | "%prop" , ident , full_mode
    | "%proof" , [ "(" , { ident } , ")" ] , ident , full_mode , cmd_body

    | "%term" , decl
    | "%block" , ident , { block_item }
    | "%union" , ident , "(" , { ident } , ")"
    | "%worlds" , "(" , { ident } , ")" , expr1 , { expr1 }
    | "%deterministic" , id_list
    | "%use" , id_list , "(" , { expr } , ")"               (* parses; unimplemented downstream *)

    | "%open" , "%require" , require_arg                    (* derived: %require then %open *)
    | "%open" , id_list
    | "%require" , require_arg
    | "%eval" , cmd_list                                    (* block is mandatory here *)
    | "%prec" , fixity , number , id_list
    | "%solve" , expr                                       (* no `name :` binding, unlike Twelf *)

    | "%quit"
    | "%help" , [ ident ]
    | "%get" , ident
    | "%set" , ident , ident
    | "%version"

    (* HAZARD: %term is a prefix of %terminates; the keyword boundary check
       (Parser.ml:40-52) is what keeps them apart, since %term is tried first. *)
    | "%total" , order_list , expr1 , { expr1 }
    | "%terminates" , order_list , expr1 , { expr1 }
    | "%covers" , mode_dec
    | "%name" , ident                                       (* no-op; one identifier, unlike Twelf *)
    | "%prose" , ident                                      (* no-op; a highlighting hint *)
    | "%reduces" , reduces_rel , expr1 , { expr1 }
    ;

    (* NOTE on `%.`  It is a SEPARATOR, not a terminator (Cmd.ml:220-226), and a
       no-op at install time (Impl.ml:557).  It is OPTIONAL between two commands
       — a declaration ends at the next unescaped `%`, since identifiers cannot
       contain one.  It is REQUIRED before prose, which does not start with `%`
       and would otherwise be absorbed as application arguments.  Corpus style
       writes it after every declaration. *)

define
    (* The payload of `%def` / `%define` (Modern.ml:660-676): a name (`_`
       allowed), an OPTIONAL type as an ATOM, then the body.
         %def not ({_ prop} prop) ([a] imp a false)

       Surface order is NAME TYPE BODY; the CST stores (name, body, type).
       The last two are swapped — see stelf.md §10.1. *)
    = ( ident | "_" ) , expr1 , expr
    ;


(* ─────────────────────────── Document ───────────────────────────────────── *)

file
    (* A complete source file (Cmd.ml:692).  Literate by default: `outer` is
       arbitrary prose, discarded by the parser.

         # Natural numbers

         We start with the type of naturals.

         %sort nat %.
         %term zero nat %.
         %term succ {_ nat} nat %.
    *)
    = outer , { cmd , outer }
    ;


(* ─────────────────────────── Not in the grammar ─────────────────────────── *)

(*
  ABSENT FROM STELF, present in Twelf.  These have no parser entry and report an
  unrecognised command:
    %theorem  %prove  %establish  %assert  %clause  %tabled  %trustme  %subord
    %sig  %struct  %include        and `%{ ... }%` block comments

  Some of them (Prove, Establish, Assert) have CST constructors but are
  unreachable from the command parser.

  TERM CONSTRUCTORS WITH NO SURFACE SYNTAX (LENS.ml:126-150).  These exist for
  the printer and for internal use; `Internal` is deliberately unparseable:
    ExistVar  FreeVar  BackArrow  Foreign  Internal  MacroParam

  DEAD CODE, listed so it is not mistaken for grammar:
    Modern.parse_expr_app (Modern.ml:409-413) — unreferenced
    Parser.blank (Parser.ml:32)               — exported, never used
    Modern.parse_sigexp / parse_sigdef / parse_struct_dec — no `cmd` uses them
    Modern.given_symbols (Modern.ml:30)       — read but never written, so
                                                `%symbol` cannot alias keywords

  THERE IS NO `%alias` COMMAND.  `alias` is a stelf.toml dependency field that
  renames the namespace a dependency is imported under (Format.ml:5,59).
*)
